# Known host and known network configs
if [ -n "$VIA_API_CHAT_BASE" ];
then
    true
elif [ "${HOSTNAME}" == "tensor" ];
then
    export VIA_API_CHAT_BASE="${VIA_API_CHAT_BASE:-http://localhost:5000}"
elif onsubnet 192\.168\.1\. ;
then
    export VIA_API_CHAT_BASE="${VIA_API_CHAT_BASE:-http://tensor-192.example.com:5000}"
elif onsubnet 10\.1\.0\. ;
then
    export VIA_API_CHAT_BASE="${VIA_API_CHAT_BASE:-http://tensor-10.example.com:5000}"
fi
