# enable.sh: source this file

[[ ":$PATH:" != *":$HOME/wip/answer/bin:"* ]] && export PATH="$HOME/wip/answer/bin:$PATH"

if [[ -n "${PS1-}" && "${PS1-}" != *"👣"* ]]; then
    export ANSWER_OLD_PS1="$PS1"
    
    if [[ "$PS1" == *'\$'* ]]; then
        #PS1="${PS1/\\$/ [\\!]👣$}"
        PS1="${PS1/\\$/👣$}"
    else
        PS1="${PS1}👣"
    fi
fi

source $HOME/wip/answer/bin/functions.sh
